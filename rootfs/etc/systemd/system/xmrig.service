[Unit]
Description=XMRig Monero miner
Wants=network-online.target
After=network-online.target

[Service]
User=xmrig
Group=xmrig
ExecStart=/opt/xmrig/xmrig --config=/opt/xmrig/config.json --no-color
Restart=always
RestartSec=10
Nice=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/xmrig /var/lib/xmrig
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
