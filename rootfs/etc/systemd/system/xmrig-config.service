[Unit]
Description=Apply Monero wallet from boot partition into XMRig config
After=local-fs.target
Before=xmrig.service thermal-guard.service
ConditionPathExists=/opt/xmrig/config.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/xmrig-apply-wallet.sh

[Install]
WantedBy=multi-user.target
